# Public repository boundary: source and documentation only.
# Datamined content, site snapshots, images and generated outputs stay local.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/AGENTS.md
!/scripts/
!/src/
!/docs/
__pycache__/
*.py[cod]
.venv/
node_modules/
.env
.env.*
*.key
*.pem

# Local historical deployment records are not part of the public source project.
/docs/*
!/docs/PROJECT-GOALS.md
!/docs/PUBLIC-REPOSITORY.md

# Current maintenance contracts and freeze record (no generated/site content).
!/docs/TEST-PAGE-CLEANUP.md
!/docs/FREEZE-2026-10-30.md
!/docs/CODE-AND-FORMATS.md

# Source-owned build/migration configuration; no local paths or game data.
!/config/
/config/*
!/config/vehicle-examples.json
!/config/vehicle-content-migration.json
